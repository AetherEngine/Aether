{
  "exclude_dirs": [],
  "exclude_files": ["web_main.zig", "services.zig"],
  "exclude_paths": [],
  "banned": [],
  "symbol_bans": [],
  "max_line_length": 100,
  "max_function_lines": 70,
  "max_file_size_mib": 1,
  "rules": {
    "control_characters": true,
    "error_comparison": true,
    "debug_assert": true,
    "comptime_not": true,
    "configured_text_bans": true,
    "leftover_reminders": true,
    "symbol_bans": true,
    "packed_fields": true,
    "trailing_whitespace": true,
    "dead_declarations": true,
    "operator_precedence": true,
    "dead_files": true,
    "file_size": true,
    "defer_newline": true,
    "deinit_undefined": true,
    "self_type": true,
    "type_function_names": true,
    "function_names": false,
    "function_length": false,
    "line_length": false
  }
}

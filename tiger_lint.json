{
  "exclude_dirs": [],
  "exclude_files": [],
  "exclude_paths": [
    "src/platform/c_io.zig",
    "src/platform/psp/constants.zig",
    "src/platform/sdl/opengl/constants.zig",
    "src/platform/sdl/vulkan/constants.zig",
    "src/platform/switch/c.zig",
    "src/platform/switch/deko.zig",
    "src/platform/switch/services.zig",
    "test/web_main.zig"
  ],
  "banned": [],
  "symbol_bans": [],
  "max_line_length": 100,
  "max_function_lines": 70,
  "max_file_size_mib": 1,
  "rules": {
    "control_characters": true,
    "error_comparison": true,
    "debug_assert": true,
    "comptime_not": true,
    "configured_text_bans": true,
    "leftover_reminders": true,
    "symbol_bans": true,
    "packed_fields": true,
    "trailing_whitespace": true,
    "dead_declarations": true,
    "operator_precedence": true,
    "dead_files": true,
    "file_size": true,
    "defer_newline": true,
    "deinit_undefined": true,
    "self_type": true,
    "type_function_names": true,
    "function_names": true,
    "function_length": false,
    "line_length": false,
    "ascii_only": true,
    "shouty_case": true
  }
}

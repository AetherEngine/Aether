{
  "exclude_dirs": [],
  "exclude_files": [],
  "exclude_paths": [
    "platform/desktop/opengl/constants.zig",
    "platform/desktop/vulkan/constants.zig",
    "platform/psp/constants.zig",
    "platform/switch/c.zig",
    "platform/switch/deko.zig",
    "platform/switch/newlib_io.zig",
    "platform/math/builtin_reference.zig"
  ],
  "banned": [],
  "symbol_bans": [
    {
      "kind": "builtin_call",
      "symbol": "@min",
      "replacement": "Aether's math.min: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@max",
      "replacement": "Aether's math.max: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@floor",
      "replacement": "Aether's math.floor: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@ceil",
      "replacement": "Aether's math.ceil: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@trunc",
      "replacement": "Aether's math.trunc: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@round",
      "replacement": "Aether's math.round: on the PSP the builtin is a library call"
    },
    {
      "kind": "builtin_call",
      "symbol": "@sin",
      "replacement": "Aether's math.sin: the builtin works in f64, which the PSP only has in software"
    },
    {
      "kind": "builtin_call",
      "symbol": "@cos",
      "replacement": "Aether's math.cos: the builtin works in f64, which the PSP only has in software"
    },
    {
      "kind": "builtin_call",
      "symbol": "@tan",
      "replacement": "Aether's math.tan: the builtin works in f64, which the PSP only has in software"
    },
    {
      "kind": "call",
      "symbol": "std.math.clamp",
      "replacement": "Aether's math.clamp: std's uses @min and @max"
    }
  ],
  "max_line_length": 100,
  "max_function_lines": 70,
  "max_file_size_mib": 1,
  "rules": {
    "control_characters": true,
    "error_comparison": true,
    "debug_assert": true,
    "comptime_not": true,
    "configured_text_bans": true,
    "leftover_reminders": true,
    "symbol_bans": true,
    "packed_fields": true,
    "trailing_whitespace": true,
    "dead_declarations": true,
    "operator_precedence": true,
    "dead_files": true,
    "file_size": true,
    "defer_newline": true,
    "deinit_undefined": true,
    "self_type": true,
    "type_function_names": true,
    "function_names": true,
    "function_length": false,
    "line_length": false,
    "ascii_only": true,
    "shouty_case": true
  }
}
